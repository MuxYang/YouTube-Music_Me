{
  "name": "youtube-music-me",
  "version": "0.1.0",
  "description": "An unofficial YouTube Music desktop client for Windows, Linux, and macOS.",
  "main": "src/main.js",
  "author": {
    "name": "MuxYang",
    "email": "3489892672@qq.com"
  },
  "desktopName": "youtube-music-me.desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage deb rpm tar.gz",
    "dist:mac": "electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.muxyang.youtubemusicme",
    "productName": "YouTube Music Me",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "src/assets/icon.png",
      "category": "AudioVideo;Audio;Player",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "hardenedRuntime": false,
      "icon": "src/assets/icon.png",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
